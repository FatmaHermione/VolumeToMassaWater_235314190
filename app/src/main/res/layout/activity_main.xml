<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- Kartu Pembungkus Konten Utama -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Judul Aplikasi -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kalkulator Volume ke Massa Air"
                android:textAlignment="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A202C"
                android:layout_marginBottom="24dp"/>

            <!-- Input Volume Air -->
            <EditText
                android:id="@+id/etVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan Volume (mL)"
                android:inputType="numberDecimal"
                android:padding="16dp"
                android:backgroundTint="#3182CE"
                android:layout_marginBottom="16dp"/>

            <!-- Tombol Hitung -->
            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hitung Massa"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="14dp"
                android:backgroundTint="#3182CE"
                android:textColor="@android:color/white"
                android:layout_marginBottom="24dp"/>

            <!-- Tampilan Hasil -->
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hasil: 0.00 gram"
                android:textAlignment="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2B6CB0"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>